# Copy this file to `.env` in the backend/ directory and fill in real values.
# Never commit the actual .env file.

# --- LLM ---
# MISTRAL_API_KEY powers BOTH the investigation agent (app/agent/client.py)
# and, optionally, evidence embeddings (app/retrieval/embeddings.py) --
# one key, two call sites. Get a free key (no credit card) from
# https://console.mistral.ai (La Plateforme, not Le Chat).
MISTRAL_API_KEY=
# mistral-large-latest is NOT included on the free "Experiment" tier and
# will fail every call with a 403 tier_not_allowed error -- if you're on
# the free tier, use mistral-small-latest (confirmed available) instead.
MISTRAL_AGENT_MODEL=mistral-small-latest

# Free-tier accounts also enforce a strict requests-per-second limit.
# Seeding/uploading a dataset calls the agent once per detected candidate
# incident in a loop -- on the free tier this can trip 429s across most or
# all of them even with per-call retry/backoff. If you see repeated 429s
# in agent_decision.error_detail, uncomment and raise this (seconds
# between successive agent calls in a batch):
# AGENT_CALL_INTERVAL_SECONDS=2.0

# ANTHROPIC_API_KEY is no longer used by the agent (see app/agent/client.py) --
# left here only in case of a future switch back. Not required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
DATABASE_URL=sqlite:///./razeyn.db

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
