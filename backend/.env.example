# Copy this file to `.env` in the backend/ directory and fill in real values.
# Never commit the actual .env file.

# --- LLM ---
# MISTRAL_API_KEY powers BOTH the investigation agent (app/agent/client.py)
# and, optionally, evidence embeddings (app/retrieval/embeddings.py) --
# one key, two call sites. Get a free key (no credit card) from
# https://console.mistral.ai (La Plateforme, not Le Chat).
MISTRAL_API_KEY=
MISTRAL_AGENT_MODEL=mistral-large-latest

# ANTHROPIC_API_KEY is no longer used by the agent (see app/agent/client.py) --
# left here only in case of a future switch back. Not required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
DATABASE_URL=sqlite:///./razeyn.db

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
