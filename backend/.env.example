# Copy this file to `.env` in the backend/ directory and fill in real values.
# Never commit the actual .env file.

# --- LLM ---
# GROQ_API_KEY powers the investigation agent (app/agent/client.py).
# Get a free key (no credit card) from https://console.groq.com --
# the free tier allows 30 requests/minute. (This project originally
# used Mistral's free tier here, but that tier's real-world rate limit
# turned out to be far stricter -- ~2 requests/minute -- than its docs
# suggested, and repeatedly caused 429s even with retry/backoff. See
# app/agent/client.py's module docstring for the full story.)
GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated by Groq (decommissioned
# 2026-08-16) -- using it now fails every call with a 404
# model_not_found error. openai/gpt-oss-120b is Groq's current
# recommended tool-calling replacement (openai/gpt-oss-20b is the
# smaller/faster option). Check https://console.groq.com/docs/models
# for the current list if this ever 404s again.
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Delay (seconds) between successive investigate_incident() calls when
# processing a batch of candidates (dataset seeding/upload) -- 0 by
# default. Groq's free tier (30 req/min) rarely needs this, but if you
# still see repeated 429s in agent_decision.error_detail, uncomment and
# raise this:
# AGENT_CALL_INTERVAL_SECONDS=2.0

# MISTRAL_API_KEY is UNRELATED to the agent above -- it's used only,
# optionally, by app/retrieval/embeddings.py's Mistral embedding
# backend, which silently falls back to a local, dependency-free
# vectorizer if this is unset. Not required for the app to function.
MISTRAL_API_KEY=

# ANTHROPIC_API_KEY is no longer used by the agent (see app/agent/client.py) --
# left here only in case of a future switch back. Not required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
DATABASE_URL=sqlite:///./razeyn.db

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
